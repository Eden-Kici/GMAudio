{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GMAudio",
  "version": "0.9.0",
  "identifier": "com.edenkici.gmaudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GMAudio",
        "width": 1320,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 640,
        "backgroundColor": "#15130f",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
